# Entorno
NODE_ENV=development
PORT=3000

# Base de datos PostgreSQL (Neon)
# Formato: postgresql://usuario:password@host/database?sslmode=require
DATABASE_URL=postgresql://usuario:password@host/database?sslmode=require

# Autenticación JWT
JWT_SECRET=changeme
JWT_EXPIRES_IN=1d

# Stripe (pagos)
# Claves de test: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_changeme
# Se obtiene al crear el endpoint del webhook (dashboard o `stripe listen`)
STRIPE_WEBHOOK_SECRET=whsec_changeme
STRIPE_CURRENCY=usd

# Cloudinary (imágenes de productos)
# Datos en https://console.cloudinary.com/ (Dashboard > Account details)
CLOUDINARY_CLOUD_NAME=changeme
CLOUDINARY_API_KEY=changeme
CLOUDINARY_API_SECRET=changeme

